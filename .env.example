# HeatShield Environment Configuration
# Copy this file to .env and provide your deployment secrets

# Flask Session Security
SECRET_KEY=heatshield-secret-production-all-india-2026

# Automated Daily Heat Check Endpoint Token (Used by AWS Lambda / EventBridge)
HEAT_CHECK_TOKEN=hs-daily-token-all-india-secure

# Caching & Weather Tuning
WEATHER_CACHE_MINUTES=30
WEATHER_TIMEOUT_SECONDS=5.0

# Amazon Web Services (SNS for Real Emergency Broadcasts & SMS Alerts)
# Leave blank to run safely in simulated local logging mode
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_TOPIC_ARN=
